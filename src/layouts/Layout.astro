---
import { path, site } from '../lib/site';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  article?: boolean;
  noindex?: boolean;
}
const { title, description = site.description, article = false, noindex = false } = Astro.props;
const pageTitle = title ? `${title} | ${site.name}` : `${site.name} | ${site.title}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const nav = [
  ['Home', ''], ['About', 'about/'], ['Blog', 'blog/'], ['Projects', 'projects/'],
];
---
<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#111416" />
    <title>{pageTitle}</title>
    {!noindex && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/svg+xml" href={path('favicon.svg')} />
    <link rel="alternate" type="application/rss+xml" title="Shane Tarleton's blog" href={path('rss.xml')} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta name="twitter:card" content="summary" />
    <script is:inline>
      try {
        if (localStorage.getItem('theme') === 'light') {
          document.documentElement.dataset.theme = 'light';
        }
      } catch (error) {
        console.warn('Theme preference cannot be read on this device.', error);
      }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header container">
      <a class="wordmark" href={path()} aria-label="Shane Tarleton, home">st<span>.</span></a>
      <nav aria-label="Main navigation">
        {nav.map(([label, route]) => (
          <a href={path(route)} aria-current={Astro.url.pathname === path(route) ? 'page' : undefined}>{label}</a>
        ))}
      </nav>
      <button id="theme-toggle" class="theme-toggle" type="button" aria-label="Switch to light theme" hidden>
        <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5" />
        </svg>
      </button>
    </header>
    <main id="main" class="container" tabindex="-1"><slot /></main>
    <footer class="site-footer container">
      <p>&copy; {new Date().getFullYear()} Shane Tarleton.<br /><span>Personal perspectives. Shared to be useful.</span></p>
      <nav aria-label="Social links">
        <a href={site.github}>GitHub</a>
        <a href={site.linkedin}>LinkedIn</a>
        <a href={path('rss.xml')}>RSS</a>
      </nav>
    </footer>
    <script>
      const button = document.querySelector<HTMLButtonElement>('#theme-toggle');
      const updateLabel = () => {
        button?.setAttribute('aria-label',
          `Switch to ${document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark'} theme`);
        document.querySelector('meta[name="theme-color"]')?.setAttribute('content',
          document.documentElement.dataset.theme === 'dark' ? '#111416' : '#faf9f6');
      };
      if (button) {
        button.hidden = false;
        updateLabel();
        button.addEventListener('click', () => {
          const theme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
          document.documentElement.dataset.theme = theme;
          updateLabel();
          try {
            localStorage.setItem('theme', theme);
          } catch (error) {
            console.warn('Theme changed, but the preference could not be saved on this device.', error);
          }
        });
      }
    </script>
  </body>
</html>
