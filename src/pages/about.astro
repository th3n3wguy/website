---
import Layout from '../layouts/Layout.astro';
import { profile, experience, earlierExperience, education } from '../data/profile';
import { path, site } from '../lib/site';
---
<Layout title="About" description="Meet Shane Tarleton, a software engineer working across industries in full-stack development, platform architecture, and release engineering.">
  <header class="page-heading"><p class="eyebrow">A little about me</p><h1>Shane Tarleton.</h1><p class="role">{profile.headline}</p><p class="intro">{profile.introduction}</p><p>{profile.approach}</p><a href={site.linkedin}>Connect on LinkedIn <span aria-hidden="true">&rarr;</span></a></header>
  <section class="section">
    <h2>How I approach the work</h2>
    <blockquote class="philosophy"><p>"If you don't have time to do it right, when will you have time to do it over?"</p><cite>John Wooden</cite></blockquote>
    <p>I value clear interfaces, maintainable systems, and sharing what I learn. The articles here are personal perspectives, not statements on behalf of an employer.</p>
  </section>
  <section class="section">
    <p class="eyebrow">The path so far</p><h2>Experience</h2>
    {experience.map(job => (
      <article class="experience">
        <h3>{job.company}</h3>
        {job.roles.map(role => (
          <div class="position">
            <div class="position-heading"><h4>{role.title}</h4><p class="muted">{role.dates}</p></div>
            {role.highlights.length > 0 && <ul>{role.highlights.map(highlight => <li>{highlight}</li>)}</ul>}
          </div>
        ))}
        {job.project && <a href={path(`projects/#${job.project.anchor}`)}>{job.project.label} <span aria-hidden="true">&rarr;</span></a>}
      </article>
    ))}
    <details class="earlier-work"><summary>Earlier experience</summary>
      {earlierExperience.map(job => (
        <article class="experience"><h3>{job.company}</h3><h4>{job.title}</h4><p class="muted">{job.dates}</p><p>{job.summary}</p></article>
      ))}
    </details>
  </section>
  <section class="section"><h2>Education</h2>
    {education.map(item => <article class="education"><h3>{item.school}</h3><p>{item.study}<br /><span class="muted">{item.dates}</span></p></article>)}
  </section>
  <section class="section"><h2>Skills &amp; certification</h2>
    <p>My work has included C#, .NET, JavaScript, TypeScript, React, Vue, Angular, Java, REST APIs, Kubernetes, and CI/CD platforms. My LinkedIn profile also lists Bootstrap, LESS, and Sass.</p>
    <p><strong>Certification:</strong> Exam 480: Programming in HTML5 with JavaScript and CSS3.</p>
  </section>
</Layout>
